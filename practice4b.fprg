<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="practice4b"/>
        <attribute name="authors" value="Plab1-12"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-03-24 03:01:22 PM"/>
        <attribute name="created" value="UGxhYjEtMTI7REVTS1RPUC1GTDJFUlJQOzIwMjUtMDMtMjQ7MDI6NTE6NTEgUE07Mjk0NA=="/>
        <attribute name="edited" value="UGxhYjEtMTI7REVTS1RPUC1GTDJFUlJQOzIwMjUtMDMtMjQ7MDM6MDE6MjIgUE07MTszMDQ2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a, b, c" type="Integer" array="False" size=""/>
            <input variable="a"/>
            <input variable="b"/>
            <input variable="c"/>
            <if expression="a&gt;b">
                <then>
                    <if expression="a&gt;c">
                        <then>
                            <output expression="a" newline="True"/>
                        </then>
                        <else>
                            <output expression="c" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="b&gt;c">
                        <then>
                            <output expression="b" newline="True"/>
                        </then>
                        <else>
                            <output expression="c" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
